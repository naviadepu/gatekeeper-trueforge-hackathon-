# TrueForge agent harness — run `npx @truefoundry/trueforge` and open http://localhost:8790
# The server holds all provider keys and the GitHub connector token; nothing
# secret belongs in this repo.
TRUEFORGE_URL=http://localhost:8790

# Model the agent runs on (provider/model FQN, must be configured in TrueForge).
TRUEFORGE_MODEL=anthropic/claude-fable-5

# Repo the agent audits. Task 3 turns this into a UI input.
GATEKEEPER_TARGET_REPO=naviadepu/portfolio-navi-deploy
